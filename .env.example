# Copy this file to .env (same folder as docker-compose.yml) and change the value.
# .env is ignored by git. Never commit the real secret.
#
# Key used to sign the JWT (HS256) returned by POST /login.
# Use a long random value (32+ characters), for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-local-env
